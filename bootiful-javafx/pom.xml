<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>bootiful-javafx</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name/>
    <description/>

    <properties>
        <main.class>com.example.bootiful_javafx.BootifulJavafxApplication</main.class>
        <javafx.version>26.0.2</javafx.version>
        <java.version>25</java.version>
    </properties>
    <dependencies>
        <!-- javafx-controls transitively brings in javafx-base and javafx-graphics.
               The OpenJFX poms auto-detect the platform classifier (mac-aarch64, linux, win). -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-client-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.spring.javaformat</groupId>
                <artifactId>spring-javaformat-maven-plugin</artifactId>
                <version>0.0.48</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <inherited>true</inherited>
                        <goals>
                            <goal>validate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <configuration>
                    <imageName>javafx-native</imageName>
                    <mainClass>${main.class}</mainClass>
                    <buildArgs>
                        <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                        <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                    </buildArgs>
                </configuration>
            </plugin> 
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- mvn -Pagent spring-boot:run   re-records JavaFX reachability metadata into
             target/native/agent-output. The smoke.test flag makes the app close itself so the
             agent gets a clean JVM shutdown, which is when it writes the file out. Use
             -Dsmoke.test=login instead to have it sign in as well, which records the OAuth path.

             The output is a *diagnostic*, not a drop-in replacement for JavaFxRuntimeHints: diff
             the two and fold in what is JavaFX's (com.sun.glass / com.sun.prism / com.sun.scenario
             / javafx.*). Everything Spring and Jackson in there is already generated by
             spring-boot:process-aot, and devtools is not in the native image at all - hence
             restart.enabled=false, so the recording matches what the image will actually run.

             Note the agent only sees what the run touches. JavaFX loads its shaders and effect
             peers by name, so no single run discovers them all; JavaFxRuntimeHints registers those
             two families wholesale rather than one run's worth. -->
        <profile>
            <id>agent</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <jvmArguments>
                                -agentlib:native-image-agent=config-output-dir=${project.build.directory}/native/agent-output
                                -Dsmoke.test=true
                                -Dspring.devtools.restart.enabled=false
                            </jvmArguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
